using System;

public class Program
{
    public static void Main()
    {
Console.WriteLine("Enter first numbar!");
string num1 = Console.ReadLine();
Console.WriteLine("Enter second numbar!");
string num2 = Console.ReadLine();
try
{
    int a = Convert.ToInt32(num1);
    int b = Convert.ToInt32(num2);
    int result = Divide(a, b);
    Console.WriteLine($"Result: {result}");
}
catch (ArgumentNullException)
{
    Console.WriteLine("IT CANT BE NULL!!!");
}
catch (FormatException)
{
    Console.WriteLine("Input was not a valid integer!");
}
catch (DivideByZeroException)
{
    Console.WriteLine("Cannot divide by zero!");
}
catch (OverflowException)
{
    Console.WriteLine("Number is too large!");
}
catch (Exception ex)
{
    Console.WriteLine($"An unexpected error occurred: {ex.Message}");
}
static int Divide(int x, int y)
    {
        return x / y;
    }
    }
}
